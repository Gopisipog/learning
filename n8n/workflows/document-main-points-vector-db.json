            {
              "message": "=You are an expert research analyst. Read the document and produce a concise briefing that preserves scope. Return sections titled 'Executive Summary' (3 sentences max), 'Key Points' (5 bullet list highlighting critical topics, each limited to 20 words), and 'Scope Notes' (clarify boundaries, assumptions, or missing details)."
            }
          ]
        },
        "promptType": "define"
      },
      "typeVersion": 1.4
    },
