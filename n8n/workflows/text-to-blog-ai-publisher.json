{
  "name": "Text to Blog AI Publisher",
  "nodes": [
    {
      "parameters": {
      "httpMethod": "GET",
      "path": "create-blog",
      "responseMode": "responseNode"
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "create-blog-webhook"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "input-text",
              "name": "inputText",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "blog-title",
              "name": "blogTitle",
              "value": "={{ $json.title || 'Untitled Blog Post' }}",
              "type": "string"
            },
            {
              "id": "author",
              "name": "author",
              "value": "={{ $json.author || 'AI Assistant' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Extract Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "model": "gpt-4o-mini",
        "text": "=You are a professional blog writer. Transform the given text into a well-structured, engaging blog post with:\n1. An attention-grabbing introduction\n2. Well-organized body paragraphs with subheadings\n3. Key takeaways or insights\n4. A compelling conclusion\n5. SEO-friendly content\n\nFormat the output in HTML with proper tags (h2, h3, p, ul, li, strong, em).\n\nTitle: {{ $json.blogTitle }}\n\nOriginal Text:\n{{ $json.inputText }}\n\nPlease transform this into a complete blog post.",
        "options": {
          "temperature": 0.7,
          "maxTokens": 2000
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [
        650,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai_credentials",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "blog-content",
              "name": "blogContent",
              "value": "={{ $json.message.content }}",
              "type": "string"
            },
            {
              "id": "word-count",
              "name": "wordCount",
              "value": "={{ $json.message.content.split(' ').length }}",
              "type": "number"
            },
            {
              "id": "generated-at",
              "name": "generatedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "title",
              "name": "title",
              "value": "={{ $('Extract Input').item.json.blogTitle }}",
              "type": "string"
            },
            {
              "id": "author",
              "name": "author",
              "value": "={{ $('Extract Input').item.json.author }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "d4e5f6a7-b8c9-0123-def1-234567890123",
      "name": "Format Blog",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://your-wordpress-site.com/wp-json/wp/v2/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, content: $json.blogContent, status: 'draft' }) }}"
      },
      "id": "e5f6a7b8-c9d0-1234-ef12-345678901234",
      "name": "Publish to WordPress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1050,
        300
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "wordpress_credentials",
          "name": "WordPress Credentials"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Blog post created successfully', data: { title: $('Format Blog').item.json.title, wordCount: $('Format Blog').item.json.wordCount, generatedAt: $('Format Blog').item.json.generatedAt, wordpressPostId: $json.id, wordpressLink: $json.link } }) }}"
      },
      "id": "f6a7b8c9-d0e1-2345-f123-456789012345",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1250,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Extract Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Input": {
      "main": [
        [
          {
            "node": "OpenAI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI": {
      "main": [
        [
          {
            "node": "Format Blog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Blog": {
      "main": [
        [
          {
            "node": "Publish to WordPress",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to WordPress": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "text-to-blog-ai-publisher",
  "tags": []
}

