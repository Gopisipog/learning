{
  "name": "Text to Blog AI Publisher (Simple)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "create-blog",
        "responseMode": "responseNode"
      },
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "input-text",
              "name": "inputText",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "blog-title",
              "name": "blogTitle",
              "value": "={{ $json.title || 'Untitled Blog Post' }}",
              "type": "string"
            },
            {
              "id": "author",
              "name": "author",
              "value": "={{ $json.author || 'AI Assistant' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-1",
      "name": "Extract Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', messages: [{ role: 'system', content: 'You are a professional blog writer. Transform the given text into a well-structured, engaging blog post with: 1) An attention-grabbing introduction 2) Well-organized body paragraphs with subheadings 3) Key takeaways or insights 4) A compelling conclusion 5) SEO-friendly content. Format the output in HTML with proper tags (h2, h3, p, ul, li, strong, em).' }, { role: 'user', content: 'Title: ' + $json.blogTitle + '\\n\\nOriginal Text:\\n' + $json.inputText + '\\n\\nPlease transform this into a complete blog post.' }], temperature: 0.7, max_tokens: 2000 }) }}"
      },
      "id": "http-1",
      "name": "OpenAI Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai_cred",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "blog-content",
              "name": "blogContent",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            },
            {
              "id": "title",
              "name": "title",
              "value": "={{ $('Extract Input').item.json.blogTitle }}",
              "type": "string"
            },
            {
              "id": "author",
              "name": "author",
              "value": "={{ $('Extract Input').item.json.author }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-2",
      "name": "Format Blog",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://your-wordpress-site.com/wp-json/wp/v2/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, content: $json.blogContent, status: 'draft' }) }}"
      },
      "id": "http-2",
      "name": "Publish to WordPress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "wp_cred",
          "name": "WordPress Credentials"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Blog post created successfully', data: { title: $('Format Blog').item.json.title, wordpressPostId: $json.id, wordpressLink: $json.link } }) }}"
      },
      "id": "respond-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1240, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Extract Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Input": {
      "main": [
        [
          {
            "node": "OpenAI Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat": {
      "main": [
        [
          {
            "node": "Format Blog",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Blog": {
      "main": [
        [
          {
            "node": "Publish to WordPress",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to WordPress": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "text-to-blog-simple",
  "tags": []
}

