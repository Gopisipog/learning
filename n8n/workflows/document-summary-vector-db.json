      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "markdown-data",
              "name": "data",
              "value": "={{ (() => { const settings = $('Settings').first().json; const summary = $json.summary || ''; return ['# Document Summary', '', '**Source:** ' + settings.path, '**Vector store:** ' + $json.vectorStoreStatus + ' (' + $json.chunksStored + ' chunks)', '**Generated:** ' + $json.timestamp, '', summary].join('\\n'); })() }}",
              "type": "string"
            },
            {
              "id": "markdown-path",
              "name": "outputPath",
              "value": "={{ (() => { const original = $('Settings').first().json.path; const segments = original.split('/'); const originalName = segments.pop() || 'document'; const dotIndex = originalName.lastIndexOf('.'); const base = dotIndex > -1 ? originalName.slice(0, dotIndex) : originalName; segments.push(base + '-summary.md'); return segments.join('/'); })() }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "keepOnlySet": false
        }
      },
      "id": "prepare-markdown",
      "name": "Prepare Markdown",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 300]
    },
    {
