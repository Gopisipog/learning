          "benefitsAndPerks": {
            "title": "Required Benefits",
            "type": "array",
            "description": "Required benefits and perks",
            "items": {
              "type": "string",
              "enum": [
                "relocation_assistance",
                "generous_paid_time_off",
                "visa_sponsorship",
                "four_day_work_week",
                "remote_work",
                "health_insurance",
                "dental_insurance",
                "vision_insurance",
                "retirement_plan"
              ]
