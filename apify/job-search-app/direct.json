          "mastersDegreeRequirements": {
            "title": "Master's Degree Requirements",
            "type": "array",
            "description": "Master's degree requirement level",
            "items": {
              "type": "string",
              "enum": [
                "Required",
                "Preferred",
                "Not Required"
              ]
