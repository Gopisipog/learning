            "items": {
              "type": "string"
            }
          },
          "industries": {
            "title": "Industries",
            "type": "array",
            "description": "Target industries",
            "items": {
              "type": "string"
            }
          },
          "companySizeRanges": {
            "title": "Company Size Ranges",
            "type": "array",
            "description": "Preferred company size ranges [min, max]"
